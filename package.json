{
  "name": "sports-screener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "vitest run src/lib/engine.test.ts",
    "test:predictor": "vitest run src/lib/predictorInsights.test.ts src/lib/predictorSelections.test.ts",
    "prepare": "svelte-kit sync",
    "wrangler:dev": "wrangler pages dev dist",
    "wrangler:deploy": "wrangler pages deploy dist",
    "audit:pwa": "node audit-pwa.mjs",
    "deploy:pwa": "npm run build && npm run wrangler:deploy && npm run audit:pwa"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "lighthouse": "^11.7.1",
    "playwright": "^1.62.0",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10",
    "wrangler": "^3.109.2"
  },
  "dependencies": {
    "@convex-dev/action-cache": "^0.3.1",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/auth": "^0.0.94",
    "@convex-dev/presence": "^0.4.0",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@lucide/svelte": "^1.27.0",
    "convex": "^1.43.0",
    "convex-ents": "^0.20.0",
    "convex-helpers": "^0.1.120"
  }
}
