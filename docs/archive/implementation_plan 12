TSDB_SPORT.rally = 'Motorsport'
TSDB_SPORT_KEYS.rally = /motor|rally|formula/i
ODDS_SPORT_PREFERENCE — rally key is missing (falls through to soccer)

// AFTER:
TSDB_SPORT.rally = 'TableTennis'  // TheSportsDB sport name for TT
TSDB_SPORT_KEYS.rally = /table.?tennis|ping.?pong/i

// ADD to ODDS_SPORT_PREFERENCE:
